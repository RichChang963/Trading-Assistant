## DO NOT COMMIT REAL SECRETS.
# Create a local .env (gitignored) or use a secret manager.
# OpenAI API Key
# Yo you can get API keys from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
# Yo you can get API keys from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Google Anthropic Claude API Key
# Yo you can get API keys from: https://platform.claude.com/docs/en/api/admin/api_keys/retrieve
CLAUDE_API_KEY=your_claude_api_key_here

# Perplexity API Key (uses OpenAI-compatible endpoint)
# Yo you can get API keys from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Neon Postgres connection string (Neon console -> Connect; keep sslmode=require)
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Embedding vector size; must match your embedding model (default 1536)
EMBEDDING_DIM=1536

# OpenRouter API Key (uses OpenAI-compatible endpoint)
# Yo you can get API keys from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
